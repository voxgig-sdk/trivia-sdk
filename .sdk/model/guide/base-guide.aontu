# Guide

guide: {
  metrics: count: entity: 2
  metrics: count: path: 2
  metrics: count: method: 2

  entity: api: {
    path: "/api.php": {
      op: list: method: *GET
      op: list: transform: res: *("`body.results`")|top
    }
  }

  entity: api_category: {
    path: "/api_category.php": {
      op: list: method: *GET
      op: list: transform: res: *("`body.trivia_categories`")|top
    }
  }

}