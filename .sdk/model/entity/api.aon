":{\"type\":\"string\"},\"type\":\"array\"},\"question\":{\"description\":\"The question text (may contain HTML entities)\",\"type\":\"string\"},\"type\":{\"description\":\"The type of question\",\"enum\":[\"multiple\",\"boolean\"],\"type\":\"string\"}},\"required\":[\"type\",\"difficulty\",\"category\",\"question\",\"correct_answer\",\"incorrect_answers\"],\"type\":\"object\"},\"type\":\"array\"}},\"required\":[\"response_code\",\"results\"],\"type\":\"object\"}}},\"description\":\"Successful response with trivia questions\"}},\"securitySource\":\"unspecified\"}"
